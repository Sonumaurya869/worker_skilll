{{ header }}

<style>
.notification-list {
  margin-top: 20px;
  font-family: 'Segoe UI', sans-serif;
}
.notification-item {
  background: #f9f9f9;
  border-left: 5px solid #4CAF50;
  padding: 15px;
  margin-bottom: 12px;
  border-radius: 6px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.1);
}
.notification-item.unseen {
  position: relative;
  border-left-color: #FF9800;
  background-color: #fff8e1;
}
.notification-details {
  font-size: 15px;
  margin-bottom: 10px;
}
.status {
  font-weight: bold;
}

.status-pending {
  color: #FFC107; /* Yellow */
}

.status-accepted {
  color: #4CAF50; /* Green */
}

.status-rejected {
  color: #F44336; /* Red */
}

.notification-actions {
  display: flex;
  gap: 10px;
}
.notification-actions .btn {
  padding: 6px 12px;
  font-size: 14px;
  text-decoration: none;
  border-radius: 4px;
  color: white;
  cursor: pointer;
}
.btn-view {
  background-color: #2196F3;
}
.btn-view:hover {
  background-color: #1976D2;
}
.btn-delete {
  background-color: #F44336;
}
.btn-delete:hover {
  background-color: #D32F2F;
}

#view-popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.seen-indicator {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
}

.seen-indicator.unseen {
  background-color: #28a745; /* Green for unseen */
}

.seen-indicator.seen {
  display: none;
}


</style>


<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}

    <div class="notification-list">
  {% if notification_list is not empty %}
    {% for notification in notification_list %}
      <div class="notification-item {{ notification.seen == 0 ? 'unseen' : 'seen' }}">
        <div class="notification-details">
          <strong>{{ notification.customer_name }}</strong><br>
          📞 {{ notification.customer_mobile }}<br>
          🕒 {{ notification.created_at|date("d M Y, h:i A") }}<br>
          Status: <span class="status status-{{ notification.status }}">{{ notification.status|capitalize }}</span>
        </div>
        <div class="notification-actions">
            <button class="btn btn-view" 
               data-id="{{ notification.id }}" 
               data-name="{{ notification.customer_name }}" 
               data-mobile="{{ notification.customer_mobile }}" 
               data-address="{{ notification.customer_address }}" 
               data-status="{{ notification.status }}" 
               data-date="{{ notification.created_at }}">
               View
            </button>
          <button class="btn btn-delete" data-id="{{ notification.id }}">Delete</button>
        </div>
          <span class="seen-indicator {% if notification.seen == '0' %}unseen{% else %}seen{% endif %}"></span>

      </div>
    {% endfor %}
  {% else %}
    <p>No notifications available.</p>
  {% endif %}
</div>





    {{ content_bottom }}</div>
{{ column_right }}</div>

<div id="view-popup-overlay" style="display:none;">
  <div id="view-popup" class="popup">
    <h3>Hire Request Details</h3>
    <p><strong>Name:</strong> <span id="popup-name"></span></p>
    <p><strong>Mobile:</strong> <span id="popup-mobile"></span></p>
    <p><strong>Address:</strong> <span id="popup-address"></span></p>
    <p><strong>Status:</strong> <span id="popup-status"></span></p>
    <p><strong>Date:</strong> <span id="popup-date"></span></p>

    <div class="popup-buttons">
      <button id="popup-accept" class="accept-request">Accept</button>
      <button id="popup-reject" class="reject-request">Reject</button>
      <button id="popup-close" class="close-popup">Close</button>
    </div>
  </div>
</div>


<script>
  $(document).ready(function () {
    $('.btn-delete').on('click', function () {
      const id = $(this).data('id');

      if (confirm('Are you sure you want to delete this notification?')) {
        $.ajax({
          url: 'index.php?route=wk_skill_cust/worker_notification/delete',
          method: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({ id: id }),
          success: function (response) {
            if (response.success) {
              $('[data-id="' + id + '"]').closest('.notification-item').remove();
            }
          }
        });
      }
    });
  });
</script>
  <script>
  $(document).ready(function () {
    // Show popup on View button click
    $('.btn-view').on('click', function () {
      const data = $(this).data();

      $('#popup-name').text(data.name);
      $('#popup-mobile').text(data.mobile);
      $('#popup-address').text(data.address);
      $('#popup-status').text(data.status);
      $('#popup-date').text(data.date);

      $('#popup-accept, #popup-reject, #popup-close').data('id', data.id);

      $('#view-popup-overlay').fadeIn();
    });

    // Close popup
    $('#popup-close').on('click', function () {
        const id = $(this).data('id');
        console.log('hxhjdhvhj');
        console.log(id);
        $.ajax({
        url: 'index.php?route=wk_skill_cust/worker_notification/markAsSeen',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ id }),
        success: function (res) {
          $('#view-popup-overlay').fadeOut();
        }
      });
      $('#view-popup-overlay').fadeOut();
    });

    // Accept/Reject
    $('#popup-accept, #popup-reject').on('click', function () {
      const id = $(this).data('id');
      const action = $(this).attr('id') === 'popup-accept' ? 'accept' : 'reject';

      $.ajax({
        url: 'index.php?route=wk_skill_cust/worker_notification/' + action,
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ id }),
        success: function (res) {
          alert('Request ' + action + 'ed successfully.');
          $('#view-popup-overlay').fadeOut();
          $('.notification-item[data-id="' + id + '"]').remove();
        }
      });
    });
  });
</script>

</script>



</div>
{{ footer }}