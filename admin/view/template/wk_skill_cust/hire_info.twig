{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-review" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
<div class="container-fluid">
  <div class="row">
      <div id="content" class="{{ class }}">
     

      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <td colspan="2" class="text-left">{{ text_hire_detail }}</td>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="width: 50%;">
              <b>{{ text_hire_reference }}</b> {{ hire_reference }}<br/>
              <b>{{ text_hire_date }}</b> {{ created_at }}<br/>
              <b>{{ text_status }}</b> {{ status }}<br/>
              {% if hire_end_date %}
             <b>{{ text_hire_end_date }}</b> {{ hire_end_date }}<br/>
  <b>{{ text_hire_days }}</b> {{ hire_days }}<br/>
  <b>{{ text_total_cost }}</b> {{ total_cost }}<br/>
{% endif %}

<form method="post" action="{{ add_end_date_action }}">
  <label for="hire_end_date"><b>{{ text_update_end_date }}</b></label>
  <input type="date" id="hire_end_date" name="hire_end_date" 
         class="form-control" 
         value="{{ hire_end_date ? hire_end_date_raw : '' }}" required>
  <button type="submit" class="btn btn-primary btn-sm mt-1">
    {{ hire_end_date ? button_update : button_add }}
  </button>
</form>

            </td>
            <td style="width: 50%;">
              <b>{{ text_customer_name }}</b> {{ customer_name }}<br/>
              <b>{{ text_customer_mobile }}</b> {{ customer_mobile }}<br/>
              <b>{{ text_customer_email }}</b> {{ email }}<br/>
              <b>{{ text_customer_address }}</b> <br/>{{ customer_address|raw }}
            </td>
          </tr>
        </tbody>
      </table>

      <h3>{{ text_worker_details }}</h3>
      <div class="row">
        <div class="col-sm-3 text-center">
          <img src="{{ worker_image }}" class="img-thumbnail" alt="{{ worker_name }}" />
        </div>
        <div class="col-sm-9">
          <table class="table table-bordered">
            <tr><td><b>{{ text_worker_name }}</b></td><td>{{ worker_name }}</td></tr>
            <tr><td><b>{{ text_skill }}</b></td><td>{{ occupation }}</td></tr>
            <tr><td><b>{{ text_experience }}</b></td><td>{{ experience }} {{ text_years }}</td></tr>
            <tr><td><b>{{ text_price_per_day }}</b></td><td>{{ price_per_day }}</td></tr>
            <tr><td><b>{{ text_dob }}</b></td><td>{{ date_of_birth }}</td></tr>
            <tr><td><b>{{ text_range_km }}</b></td><td>{{ range_km }} km</td></tr>
            <tr><td><b>{{ text_rating }}</b></td><td>{{ avg_rating }}/5 ({{ review_count }} {{ text_reviews }})</td></tr>
            <tr><td><b>{{ text_likes }}</b></td><td>{{ likes }} 👍 | {{ dislikes }} 👎</td></tr>
            <tr><td><b>{{ text_description }}</b></td><td>{{ description }}</td></tr>
          </table>
          <a href="{{ worker_profile_link }}" class="btn btn-secondary"><i class="fa fa-user"></i> {{ button_view_profile }}</a>
          <a href="tel:{{ worker_phone }}" class="btn btn-success"><i class="fa fa-phone"></i> {{ button_call_worker }}</a>
        </div>
      </div>

      {% if status == 'completed' and not has_reviewed %}
      <h4>{{ text_rate_worker }}</h4>
      <form action="{{ review_action }}" method="post">
        <label for="rating">{{ text_rating }}</label>
        <select name="rating" id="rating" class="form-control">
          <option value="1">1 - Poor</option>
          <option value="2">2 - Fair</option>
          <option value="3">3 - Good</option>
          <option value="4">4 - Very Good</option>
          <option value="5">5 - Excellent</option>
        </select>
        <label for="comment">{{ text_comment }}</label>
        <textarea name="comment" id="comment" class="form-control"></textarea>
        <button type="submit" class="btn btn-primary mt-2">{{ button_submit_review }}</button>
      </form>
      {% endif %}


      <div class="button_block">
      {% if status == 'pending' %}
        <a href="{{ cancel_link }}" class="btn btn-danger" style="margin: 5px;"><i class="fa fa-times-circle"></i> {{ button_cancel }}</a>
      {% endif %}
      {# {% if status == 'accepted' %}
        <a href="{{ extend_link }}" class="btn btn-warning"><i class="fa fa-clock-o"></i> {{ button_extend }}</a>
      {% endif %} #}

      <a href="{{ invoice_download_link }}" class="btn btn-default" style="margin: 5px;"><i class="fa fa-file-pdf-o"></i> {{ button_invoice }}</a>
      
      <form action="{{ change_status_action }}" method="post" class="status_block">
         <select name="new_status" class="form-control me-2">
             {% for status in workerStatusList %}
               <option value="{{ status.work_status_id }}" {% if status.name == current_status %}selected{% endif %}>
               {{ status.name|capitalize }}
               </option>
              {% endfor %}
          </select>
          <button type="submit" class="btn btn-primary">
            Change Status
          </button>
      </form>
    
    
    </div>

      <h4>{{ text_customer_location }}</h4>
      <iframe src="https://maps.google.com/maps?q={{ customer_address|url_encode }}&output=embed" width="100%" height="250" frameborder="0"></iframe>

      <div class="buttons clearfix">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
      
   <div>      
</div>
</div>

{{ footer }}
