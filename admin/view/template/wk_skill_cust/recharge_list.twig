{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-recharge').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <button type="button" form="form-recharge" formaction="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-recharge').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}

    <div class="row">
      <!-- Filter Panel -->
      <div id="filter-recharge" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label" for="input-name">{{ entry_customer_name }}</label>
              <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_customer_name }}" id="input-name" class="form-control" />
            </div>

            <div class="form-group">
              <label class="control-label" for="input-email">{{ entry_customer_email }}</label>
              <input type="text" name="filter_email" value="{{ filter_email }}" placeholder="{{ entry_customer_email }}" id="input-email" class="form-control" />
            </div>

            <div class="form-group">
              <label class="control-label" for="input-plan">{{ entry_plan }}</label>
              <input type="text" name="filter_plan" value="{{ filter_plan }}" placeholder="{{ entry_plan }}" id="input-plan" class="form-control" />
            </div>

            <div class="form-group">
              <label class="control-label" for="input-start-date">{{ entry_start_date }}</label>
              <input type="date" name="filter_start_date" value="{{ filter_start_date }}" id="input-start-date" class="form-control" />
            </div>

            <div class="form-group">
              <label class="control-label" for="input-end-date">{{ entry_end_date }}</label>
              <input type="date" name="filter_end_date" value="{{ filter_end_date }}" id="input-end-date" class="form-control" />
            </div>

            <div class="form-group">
              <label class="control-label" for="input-status">{{ entry_status }}</label>
             <select name="filter_status" id="input-status" class="form-control">
    <option value=""></option>
    {% if filter_status == '1' %}
        <option value="1" selected="selected">{{ text_enabled }}</option>
        <option value="0">{{ text_disabled }}</option>
        <option value="-1">{{ text_expired }}</option>
    {% elseif filter_status == '0' %}
        <option value="1">{{ text_enabled }}</option>
        <option value="0" selected="selected">{{ text_disabled }}</option>
        <option value="-1">{{ text_expired }}</option>
    {% elseif filter_status == '-1' %}
        <option value="1">{{ text_enabled }}</option>
        <option value="0">{{ text_disabled }}</option>
        <option value="-1" selected="selected">{{ text_expired }}</option>
    {% else %}
        <option value="1">{{ text_enabled }}</option>
        <option value="0">{{ text_disabled }}</option>
        <option value="-1">{{ text_expired }}</option>
    {% endif %}
</select>

            </div>

            <div class="form-group text-right">
              <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Recharge Table -->
      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
          </div>
          <div class="panel-body">
            <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-recharge">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                      <td class="text-left"><a href="{{ sort_recharge }}">{{ column_recharge_id }}</a></td>
                      <td class="text-left"><a href="{{ sort_name }}">{{ column_customer_name }}</a></td>
                      <td class="text-left">{{ column_customer_email }}</td>
                      <td class="text-left">{{ column_plan }}</td>
                      <td class="text-left"><a href="{{ sort_start_date }}">{{ column_start_date }}</a></td>
                      <td class="text-left"><a href="{{ sort_end_date }}">{{ column_end_date }}</a></td>
                      <td class="text-left">{{ column_status }}</td>
                      <td class="text-right">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% if recharges %}
                      {% for recharge in recharges %}
                        <tr>
                          <td class="text-center">
                            {% if recharge.recharge_id in selected %}
                              <input type="checkbox" name="selected[]" value="{{ recharge.recharge_id }}" checked="checked" />
                            {% else %}
                              <input type="checkbox" name="selected[]" value="{{ recharge.recharge_id }}" />
                            {% endif %}
                          </td>
                          <td class="text-left">{{ recharge.recharge_id }}</td>
                          <td class="text-left">{{ recharge.customer_name }}</td>
                          <td class="text-left">{{ recharge.customer_email }}</td>
                          <td class="text-left">{{ recharge.plan }}</td>
                          <td class="text-left">{{ recharge.start_date|date("d-m-Y H:i") }}</td>
                          <td class="text-left">{{ recharge.end_date|date("d-m-Y H:i") }}</td>
                          <td class="text-left">
                           {% if recharge.status == 'Active' %}
                               <span class="label label-success">{{ recharge.status }}</span>
                           {% elseif recharge.status == 'Pending' %}
                               <span class="label label-warning">{{ recharge.status }}</span>
                           {% else %}
                               <span class="label label-danger">{{ recharge.status }}</span>
                           {% endif %}

                          </td>
                          <td class="text-right">
                            <a href="{{ recharge.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-info"><i class="fa fa-eye"></i></a>
                          </td>
                        </tr>
                      {% endfor %}
                    {% else %}
                      <tr>
                        <td class="text-center" colspan="9">{{ text_no_results }}</td>
                      </tr>
                    {% endif %}
                  </tbody>
                </table>
              </div>
            </form>
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript"><!--
  $('#button-filter').on('click', function() {
      var url = '';

      var filter_name = $('input[name=\'filter_name\']').val();
      if (filter_name) url += '&filter_name=' + encodeURIComponent(filter_name);

      var filter_email = $('input[name=\'filter_email\']').val();
      if (filter_email) url += '&filter_email=' + encodeURIComponent(filter_email);

      var filter_plan = $('input[name=\'filter_plan\']').val();
      if (filter_plan) url += '&filter_plan=' + encodeURIComponent(filter_plan);

      var filter_start_date = $('input[name=\'filter_start_date\']').val();
      if (filter_start_date) url += '&filter_start_date=' + encodeURIComponent(filter_start_date);

      var filter_end_date = $('input[name=\'filter_end_date\']').val();
      if (filter_end_date) url += '&filter_end_date=' + encodeURIComponent(filter_end_date);

      var filter_status = $('select[name=\'filter_status\']').val();
      if (filter_status !== '') url += '&filter_status=' + encodeURIComponent(filter_status);

      location = 'index.php?route=wk_skill_cust/recharge&user_token={{ user_token }}' + url;
  });
  //--></script>
</div>
{{ footer }}
